{
    "manifest_version": 3,
    "name": "Obsidian Ao3",
    "version": "1.4",
    "description": "A custom, modern dark theme for Archive of Our Own Website",
    "browser_specific_settings": {
        "gecko": {
            "id": "obsidian-ao3@pixelstarforge",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "web_accessible_resources": [
        {
            "resources": [
                "src/styles/assets/*.png"
            ],
            "matches": [
                "*://*.archiveofourown.org/*"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.archiveofourown.org/*"
            ],
            "js": [
                "src/scripts/observer.js"
            ],
            "css": [
                "src/styles/core/variables.css",
                "src/styles/core/main.css",
                "src/styles/layout/header.css",
                "src/styles/layout/footer.css",
                "src/styles/components/aboutus.css",
                "src/styles/components/ao3_filter_extension.css",
                "src/styles/components/autocomplete.css",
                "src/styles/components/bookmark_badges.css",
                "src/styles/components/chapter/bookmark_form.css",
                "src/styles/components/chapter/chapter_afterwork.css",
                "src/styles/components/chapter/chapter_metadata.css",
                "src/styles/components/chapter/chapter_navigation_actions.css",
                "src/styles/components/chapter/chapter_story.css",
                "src/styles/components/checkbox_radio.css",
                "src/styles/components/collection_new.css",
                "src/styles/components/confirm_block_mute.css",
                "src/styles/components/dashboard.css",
                "src/styles/components/edit_multiple.css",
                "src/styles/components/error.css",
                "src/styles/components/fandoms_index.css",
                "src/styles/components/fic_card.css",
                "src/styles/components/filter.css",
                "src/styles/components/flash.css",
                "src/styles/components/forms.css",
                "src/styles/components/full_page_index.css",
                "src/styles/components/home/browse_module.css",
                "src/styles/components/home/favorite_module.css",
                "src/styles/components/home/intro_module.css",
                "src/styles/components/home/message_module.css",
                "src/styles/components/home/news_module.css",
                "src/styles/components/home/social_module.css",
                "src/styles/components/inbox_comment.css",
                "src/styles/components/modal.css",
                "src/styles/components/navigation_actions.css",
                "src/styles/components/orphan_new.css",
                "src/styles/components/page_update_tags.css",
                "src/styles/components/pagination.css",
                "src/styles/components/preferences.css",
                "src/styles/components/primary_user_module.css",
                "src/styles/components/profile_info.css",
                "src/styles/components/reply_comment.css",
                "src/styles/components/rich_text_editor.css",
                "src/styles/components/series_edit.css",
                "src/styles/components/series_manage.css",
                "src/styles/components/skins_card.css",
                "src/styles/components/symbol_question_mark.css",
                "src/styles/pages/admin_post.css",
                "src/styles/pages/block_mute.css",
                "src/styles/pages/bookmarks.css",
                "src/styles/pages/chapter_show.css",
                "src/styles/pages/collections_bookmarks.css",
                "src/styles/pages/collections_edit.css",
                "src/styles/pages/collections_fandoms.css",
                "src/styles/pages/collections_profile.css",
                "src/styles/pages/collections_signup.css",
                "src/styles/pages/collections_works.css",
                "src/styles/pages/donate.css",
                "src/styles/pages/faq.css",
                "src/styles/pages/fics.css",
                "src/styles/pages/gift_exchange.css",
                "src/styles/pages/home.css",
                "src/styles/pages/profile.css",
                "src/styles/pages/search.css",
                "src/styles/pages/series.css",
                "src/styles/pages/skins.css",
                "src/styles/pages/tag_sets.css",
                "src/styles/pages/tags.css",
                "src/styles/pages/users_bookmarks.css",
                "src/styles/pages/users_inbox.css",
                "src/styles/pages/users_readings.css",
                "src/styles/pages/users_stats.css",
                "src/styles/pages/users_subscriptions.css",
                "src/styles/pages/users_works.css",
                "src/styles/pages/work_edit.css",
                "src/styles/pages/works_show_multiple.css",
                "src/styles/pages/wrangling.css"
            ],
            "run_at": "document_start"
        }
    ]
}
